APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://beta.cinemaxzmeny.eu

# The reverse proxy in front of this app, so X-Forwarded-Proto is honoured and generated URLs
# stay https. An address or comma-separated list; `*` only when nothing can reach the origin
# directly. Empty means "not behind a proxy".
TRUSTED_PROXIES=

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=forge
DB_USERNAME=forge
DB_PASSWORD=

BROADCAST_DRIVER=null
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# true whenever APP_URL is https - otherwise the session cookie has no Secure flag and will be
# sent over any accidental plain-HTTP request.
SESSION_SECURE_COOKIE=true
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1

PULSE_ENABLED=true

# Optional. Without a key the "AI navrhni rozpis" button never renders and the
# rozpis builder works fully by hand. Key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

BCRYPT_ROUNDS=12
